{
  "name": "moviedb",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p web"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
